{
  "schemaVersion": 1,
  "id": "modotimizacao",
  "version": "${version}",
  "name": "Mod de Otimizacao",
  "description": "Mod de otimizacao client-side de alto desempenho para Minecraft 26.3.",
  "authors": [
    "BadTonho"
  ],
  "contact": {
    "homepage": "https://github.com/BadTonho/ModOtimizacao"
  },
  "license": "MIT",
  "icon": "assets/modotimizacao/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.modotimizacao.core.ModClientInitializer"
    ]
  },
  "mixins": [
    "modotimizacao.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  }
}
